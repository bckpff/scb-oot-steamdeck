+# ---- moving hints onto another Lichii build -----------------------------------------------------
+# A newer Lichii build can lower the same native program to other code (build 130 and later append the
+# native address map, for example), so the shader hashes in the hints no longer name its code.
+# build_code_store.py lowers every program with both builds and writes remap.tsv; this moves each record
+# onto the new hashes and fixes the environment header fields that follow the code.
+ENV_SIZE, ENV_TEXTURE_BOUND, ENV_CACHED_LOWEST, ENV_CACHED_HIGHEST = 0, 52, 60, 64
+
+
+def load_remap(path):
+    """{old hash: (new hash, new code size, new texture buffer or -1, stage)}"""
+    remap = {}
+    for line in open(path):
+        if line.strip():
+            old, new, size, tb, stage = line.split('\t')
+            remap[int(old, 16)] = (int(new, 16), int(size), int(tb), stage.strip())
+    return remap
+
+
+def remap_meta(meta, size, tb):
+    m = bytearray(meta)
+    struct.pack_into('<Q', m, ENV_SIZE, size)
+    if tb >= 0:                                     # as the emulator: a lowered TEX names its buffer, else the env's stays
+        struct.pack_into('<I', m, ENV_TEXTURE_BOUND, tb)
+    struct.pack_into('<II', m, ENV_CACHED_LOWEST, 0, size - 8)
+    return bytes(m)
+
+
+def translate_records(records, ages, remap):
+    """(records, ages) with every shader hash moved to the new build; records whose shaders are not in the map are kept
+    as they are (rebuild() then skips them, or keeps them where the code did not change)."""
+    old_task = {h for h, r in remap.items() if r[3] == 'task'}
+    old_mesh = {h for h, r in remap.items() if r[3] == 'mesh'}
+    out, new_ages, moved, missing = {}, {}, 0, 0
+    for (kind, ident), metas in records.items():
+        new_ident, new_metas = None, None
+        if kind == 'c':
+            r = remap.get(struct.unpack_from('<Q', ident, 0)[0])
+            if r and len(metas) == 1:
+                new_ident = struct.pack('<Q', r[0]) + ident[8:]
+                new_metas = [remap_meta(metas[0], r[1], r[2])]
+        else:
+            h, state = ident
+            x = 0
+            if h[1] and h[3]:                             # mesh pipeline: slots 1 and 3 hold hash ^ mesh state hash
+                x = next((h[3] ^ t for t in old_mesh if (h[1] ^ h[3] ^ t) in old_task), None)
+            if x is not None:
+                slots, maps = [], []
+                for i, v in enumerate(h):
+                    if not v:
+                        slots.append(0); continue
+                    xi = x if i in (1, 3) else 0
+                    r = remap.get(v ^ xi)
+                    if r is None:
+                        break
+                    slots.append(r[0] ^ xi); maps.append(r)
+                else:
+                    if len(maps) == len(metas):
+                        new_ident = (tuple(slots), state)
+                        new_metas = [remap_meta(m, r[1], r[2]) for m, r in zip(metas, maps)]
+        if new_ident is None:
+            missing += 1
+            new_ident, new_metas = ident, metas
+        else:
+            moved += 1
+        out[(kind, new_ident)] = new_metas
+        if (kind, ident) in ages:
+            new_ages[(kind, new_ident)] = min(new_ages.get((kind, new_ident), UNKNOWN_AGE), ages[(kind, ident)])
+    print(f'hints moved onto this Lichii build: {moved} of {len(records)} pipelines ({missing} have shaders the map does not cover)')
+    return out, new_ages
+
+
